# Copy to .env.local for development. On Vercel these live in
# Project Settings -> Environment Variables.

# --- Contact form email (Resend: https://resend.com/api-keys) ----------------
# Required for enquiries to be delivered. Without it the form reports failure
# in production, and only logs in development.
RESEND_API_KEY=""

# Where enquiries are sent. Optional: falls back to site.email in site.config.ts.
# Keep the team's own inbox here rather than in the repository.
NOTIFY_EMAIL_TO=""

# The From header. Resend only accepts a sender on a domain you have verified
# with them; until that is done, leave this unset and the default
# onboarding@resend.dev is used, which delivers to the Resend account owner only.
NOTIFY_EMAIL_FROM=""

# Origin of the deployed site, used for the logo in the email footer. Read on
# the server only. Without a real https URL the footer falls back to a typeset
# wordmark. Example: https://facility.bi
SITE_URL=""

# --- Database (not in use yet) ----------------------------------------------
# Postgres (Neon free tier or any Postgres 14+)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
